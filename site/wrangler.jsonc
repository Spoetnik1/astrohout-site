{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "astrohout-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// the site's own domain: Cloudflare links these to the Worker (and creates their DNS records) on every deploy
	"routes": [
		{ "pattern": "astrohout.nl", "custom_domain": true },
		{ "pattern": "www.astrohout.nl", "custom_domain": true }
	],
	// contact form: sends each message to the inbox below, from an address on our own domain.
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": ["website@astrohout.nl"],
			"allowed_destination_addresses": ["info@astrohout.nl"]
		}
	],
	// the contact form also needs the secret TURNSTILE_SECRET_KEY. Secrets are set in the Cloudflare dashboard
	// (Settings > Variables and Secrets), never in this file; until it is set the form shows its error message.
	// preview links (one per pull request) don't inherit the settings above, so the contact form gets them here too
	"previews": {
		"send_email": [
			{
				"name": "EMAIL",
				"allowed_sender_addresses": ["website@astrohout.nl"],
				"allowed_destination_addresses": ["info@astrohout.nl"]
			}
		]
	}
}