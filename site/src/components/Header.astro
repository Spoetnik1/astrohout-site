---
import { nav } from '../data/site';
import { cleanPath } from '../utils/path';

const here = cleanPath(Astro.url.pathname);
---
<header class="top">
  <!-- generated oak grain: stretched noise folded into bands, tinted oak → teak -->
  <svg class="grain" aria-hidden="true">
    <filter id="wood" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.0011 0.028" numOctaves="3" seed="11"/>
      <feComponentTransfer>
        <feFuncR type="table" tableValues="0 0 .12 .55 .12 0 0 .1 .4 .1 0 0 .12 .55 .12 0 0 .1 .4 .1 0 0 .12 .55 .12 0"/>
      </feComponentTransfer>
      <feColorMatrix type="matrix" values="-.094 0 0 0 .918  -.141 0 0 0 .863  -.196 0 0 0 .769  0 0 0 0 1"/>
    </filter>
    <rect width="100%" height="100%" filter="url(#wood)"/>
  </svg>
  <div class="wrap">
    <a class="brand" href="/" aria-label="Astrohout home">
      <img src="/logo/base-logo.svg" alt="">
      <span>astrohout</span>
    </a>
    <button class="burger" aria-label="Menu" aria-expanded="false" aria-controls="nav"><i></i><i></i></button>
    <nav class="nav" id="nav">
      {nav.map(({ href, label }) => (
        <a href={href} aria-current={href === here ? 'page' : here.startsWith(`${href}/`) && href !== '/' ? 'true' : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  // mobile menu
  const burger=document.querySelector('.burger')!,nav=document.getElementById('nav')!;
  burger.addEventListener('click',()=>{
    const open=nav.classList.toggle('open');
    burger.setAttribute('aria-expanded',String(open));
    document.body.style.overflow=open?'hidden':'';
  });
</script>
