---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import bed8 from '../assets/portfolio/bed8.jpg';
import keuken1 from '../assets/portfolio/keuken1.jpg';
import schappen1 from '../assets/portfolio/schappen1.jpg';
import hek1 from '../assets/portfolio/hek1.jpg';

const slides = [
  { src: bed8, alt: 'Zolderslaapkamer met bed van massief hout en ingebouwde kasten' },
  { src: keuken1, alt: 'Keuken op maat met groene kasten en houten werkblad' },
  { src: schappen1, alt: 'Inbouwkasten met open schappen onder een schuin dak' },
  { src: hek1, alt: 'Traphek met spijlen van natuurlijk gevormde takken' },
];
---
<BaseLayout
  title="AstroHout · meubels op maat"
  description="AstroHout: meubels en interieurwerk op maat, met de hand gemaakt door één maker."
>
<main>
  <div class="wrap">
    <div class="slides" aria-label="Projecten van AstroHout">
      {slides.map((s, i) => (
        <Image
          src={s.src}
          alt={s.alt}
          class={i === 0 ? 'on' : undefined}
          widths={[800, 1200, 1600, 2400]}
          sizes="(max-width: 860px) calc(100vw - 76px), min(1360px, calc(94vw - 72px))"
          priority={i === 0}
          loading={i === 0 ? undefined : 'lazy'}
        />
      ))}
    </div>

    <section class="intro">
      <h1>Interieur op maat</h1>
      <p>Kasten, keukens, binnen- en buitenwerk.</p>
      <div class="cta-spot"><a class="btn" href="/portfolio">Bekijk het werk <Arrow /></a></div>
    </section>
  </div>
</main>
</BaseLayout>

<style is:global>
  /* ===== hero slideshow ===== */
  .slides{position:relative;aspect-ratio:3/2;overflow:hidden;background:#f2f2f2;}
  .slides img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .8s ease-in-out;}
  .slides img.on{opacity:1;}

  /* ===== intro ===== */
  .intro{text-align:center;padding:64px 0 96px;}
  .intro h1{font-size:clamp(30px,3.6vw,40px);line-height:1.5;}
  .intro p{font-size:14px;letter-spacing:.01em;color:var(--ink-soft);margin-top:4px;}
  .cta-spot{margin-top:48px;}
  @media (min-width:861px){
    .intro{padding:120px 0 150px;}
  }
  @media (max-width:860px){
    .slides{aspect-ratio:4/5;}
    .intro{padding:72px 0 96px;}
  }
  @media (prefers-reduced-motion:reduce){
    .slides img{transition:none;}
  }
</style>

<script>
  // crossfading hero slideshow
  const slides=[...document.querySelectorAll('.slides img')];
  let i=0;
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches){
    setInterval(()=>{
      slides[i].classList.remove('on');
      i=(i+1)%slides.length;
      slides[i].classList.add('on');
    },4500);
  }
</script>
