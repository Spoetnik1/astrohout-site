---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { contact, contactform } from '../data/site';
import kamer from '../assets/portfolio/single_room1.jpg';

// Turnstile (anti-spam): Cloudflare's always-passing test key while developing, the real one on the site
const turnstileKey = import.meta.env.DEV ? '1x00000000000000000000AA' : contactform.turnstileSiteKey;
---
<BaseLayout
  title="Contact · Astrohout"
  description="Neem contact op met Astrohout voor een meubel op maat: mail, Instagram of via het contactformulier."
>
<main>
<section class="narrow contact">
  <div class="info">
    <span class="eyebrow">Contact</span>
    <h1>Vertel eens.</h1>
    <p class="lead">Elk meubel begint met een gesprek. Vertel wat je in gedachten hebt, hoe vaag of precies ook, dan denk ik mee over ontwerp, houtsoort en planning.</p>

    <form class="note" id="contactform" action="/api/contact" method="post" novalidate>
      <div class="note-head"><span>Contactformulier</span><span class="brand note-brand"><img src="/logo/base-logo.svg" alt=""><span>astrohout</span></span></div>
      <h2>Stuur een bericht</h2>
      <p>Vul je gegevens in en vertel kort wat je zoekt. Ik neem daarna contact met je op.</p>

      <div class="fields">
        <label class="field">
          <span class="label">Naam</span>
          <input class="input" name="naam" autocomplete="name" required>
          <span class="err">Vul je naam in.</span>
        </label>
        <label class="field">
          <span class="label">Woonplaats</span>
          <input class="input" name="woonplaats" autocomplete="address-level2" required>
          <span class="err">Vul je woonplaats in.</span>
        </label>
        <label class="field">
          <span class="label">E-mail</span>
          <input class="input" type="email" name="email" autocomplete="email" required>
          <span class="err">Vul een geldig e-mailadres in.</span>
        </label>
        <label class="field">
          <span class="label">Telefoonnummer <i>(optioneel)</i></span>
          <input class="input" type="tel" name="telefoon" autocomplete="tel">
        </label>
        <label class="field wide">
          <span class="label">Wat zou je willen laten ontwerpen of maken?</span>
          <textarea class="input" name="bericht" rows="5" required placeholder="Bijvoorbeeld: een kastenwand onder het schuine dak, ongeveer 3 meter breed…"></textarea>
          <span class="err">Vertel kort wat je zoekt.</span>
        </label>
      </div>

      <!-- Turnstile only shows itself when it needs you to click; usually it stays invisible -->
      <div class="cf-turnstile" data-sitekey={turnstileKey} data-language="nl" data-theme="light" data-size="flexible" data-appearance="interaction-only"></div>

      <button class="btn" type="submit">Verstuur bericht <Arrow /></button>
      <p class="hint">Je gegevens gebruik ik alleen om op je bericht te reageren.</p>
      <p class="fail" id="fail" role="alert" hidden><span></span> Je kunt ook direct mailen naar <a href={`mailto:${contact.email}`}>{contact.email}</a>.</p>
      <div class="thanks" id="thanks" role="status" hidden></div>
    </form>

    <dl class="lines">
      <div><dt>Mail</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
      <div><dt>Instagram</dt><dd><a href={contact.instagram.href}>{contact.instagram.handle}</a></dd></div>
      <div><dt>Werkplaats</dt><dd>Nederland<small>Langskomen kan, op afspraak.</small></dd></div>
    </dl>

    <div class="next">
      <h3>En dan?</h3>
      <p>Ik reageer meestal binnen een dag. Daarna plannen we een kennismaking: stap 1 van de <a href="/werkwijze">werkwijze</a>.</p>
    </div>
  </div>

  <figure class="photo">
    <Image src={kamer} alt="Kamer met wanden, open kasten en een bedbak van multiplex" widths={[480, 840, 1260]} sizes="(max-width: 860px) calc(100vw - 2 * var(--gut)), 420px" priority />
  </figure>
</section>
</main>
</BaseLayout>

<style is:global>
  /* ===== contact left, photo right, in the same column as the other pages (like Over) ===== */
  .contact{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,420px);gap:clamp(40px,6vw,96px);align-items:start;}
  .info{padding-bottom:clamp(72px,9vw,120px);}
  .photo{   /* sits a bit lower than the title, like the portrait on Over; stays put while the form scrolls */
    position:sticky;top:calc(var(--hh) + 28px);margin-top:calc(30px + clamp(40px,5vw,72px));
    background:#d9d2c4;
  }
  .photo img{width:100%;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:72% 50%;}

  .eyebrow{display:inline-block;padding:7px 14px 0 9px;border-top:1px solid;border-left:1px solid;
    font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;line-height:1.4;color:var(--pencil);}
  h1{font-size:clamp(46px,5.6vw,76px);line-height:1;margin-top:22px;}
  .lead{font-size:15px;line-height:1.95;max-width:44ch;margin-top:20px;}

  /* direct lines */
  .lines{margin-top:56px;border-top:1px solid var(--ink);}
  .lines > div{display:grid;grid-template-columns:120px minmax(0,1fr);align-items:baseline;gap:16px;padding:16px 0;border-bottom:1px solid var(--line);}
  .lines dt{font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);}
  .lines dd{font-size:clamp(18px,1.7vw,22px);font-weight:500;color:var(--ink-soft);letter-spacing:-.01em;}
  .lines dd a{transition:color .2s;}
  .lines dd a:hover{color:var(--rust);}
  .lines dd small{display:block;font-size:12px;font-weight:400;letter-spacing:0;color:var(--ink-soft);margin-top:2px;}

  /* contact form, on a sheet of drawing paper */
  .note{
    position:relative;margin-top:44px;padding:30px clamp(20px,3vw,36px) 32px;
    background:#FFFDF8;border:1px solid #d8cfc2;
    background-image:linear-gradient(rgba(138,90,51,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(138,90,51,.06) 1px,transparent 1px);
    background-size:20px 20px;
    box-shadow:0 1px 0 rgba(43,29,20,.05),0 14px 32px rgba(43,29,20,.10);
  }
  .note-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-bottom:14px;border-bottom:1px solid #d8cfc2;
    font-size:10px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);}
  .note-brand{gap:8px;}   /* logo + name, a small version of the header brand */
  .note-brand img{height:26px;}
  .note-brand span{font-size:17px;text-transform:none;letter-spacing:-.02em;}
  .note h2{font-size:clamp(24px,2.4vw,30px);line-height:1.3;margin:22px 0 4px;}
  .note > p{font-size:13px;line-height:1.9;}
  .fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 20px;margin-top:26px;}
  .field{display:block;}
  .field.wide{grid-column:1 / -1;}
  .label{display:block;margin-bottom:8px;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);}
  .label i{font-style:normal;font-weight:500;letter-spacing:.04em;text-transform:none;color:#9c8f80;}
  .input{
    display:block;width:100%;padding:12px 14px;border:1px solid #cfc3b3;border-radius:0;background:#fff;
    font-size:15px;line-height:1.5;color:var(--ink);outline:none;transition:border-color .2s,box-shadow .2s;
  }
  .input::placeholder{color:#b3a696;}
  .input:hover{border-color:#b3a696;}
  .input:focus{border-color:var(--pencil);box-shadow:0 0 0 3px rgba(138,90,51,.15);}
  .input:user-invalid,.tried .input:invalid{border-color:#b3261e;}
  textarea.input{min-height:150px;resize:vertical;}
  .err{display:none;margin-top:6px;font-size:12px;color:#b3261e;}
  .input:user-invalid + .err,.tried .input:invalid + .err{display:block;}
  .cf-turnstile{margin:24px 0 -24px;}   /* takes no room while invisible, sits above the button when it asks for a click */
  .note .btn{margin-top:32px;}
  .note .btn:disabled{opacity:.6;cursor:wait;}
  .fail{margin-top:16px;padding:14px 18px;border-left:2px solid #b3261e;background:#fff;font-size:13px;line-height:1.8;}
  .fail a{border-bottom:1px solid currentColor;}
  .hint{margin-top:12px;font-size:12px;color:var(--ink-soft);}
  .thanks{margin-top:26px;padding:22px 24px;border-left:2px solid var(--pencil);background:#fff;}
  .thanks h3{font-size:22px;line-height:1.3;}
  .thanks p{font-size:14px;line-height:1.9;margin-top:6px;}
  .note.sent .fields,.note.sent .btn,.note.sent .hint,.note.sent > p,.note.sent .cf-turnstile{display:none;}

  .next{margin-top:56px;padding-top:28px;border-top:1px solid var(--line);}
  .next h3{font-size:20px;line-height:1.4;}
  .next p{font-size:14px;line-height:2;max-width:46ch;margin-top:8px;}
  .next a{border-bottom:1px solid currentColor;}
  .next a:hover{color:var(--rust);}

  @media (max-width:860px){
    .contact{grid-template-columns:1fr;gap:0;}
    .photo{order:-1;position:relative;top:auto;margin:0;}   /* photo on top, then the text */
    .photo img{aspect-ratio:4/3;object-position:50% 50%;}
    .info{margin-top:32px;padding-bottom:72px;}
    .lines > div{grid-template-columns:1fr;gap:4px;}
    .fields{grid-template-columns:1fr;}
  }
  @media (prefers-reduced-motion:reduce){
    .input,.lines dd a{transition:none;}
  }
</style>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
  // contact form: the browser checks the fields, then /api/contact checks Turnstile and mails the message.
  const form=document.getElementById('contactform') as HTMLFormElement,
        thanks=document.getElementById('thanks')!,fail=document.getElementById('fail')!,
        button=form.querySelector('button')!;
  const errors:Record<string,string>={
    turnstile:'De spamcontrole is niet gelukt. Probeer het nog een keer.',
    invalid:'Niet alle velden zijn goed ingevuld.',
  };
  form.addEventListener('submit',async e=>{
    e.preventDefault();
    if(!form.checkValidity()){
      form.classList.add('tried');   // from now on, show which fields still need attention
      form.reportValidity();
      return;
    }
    fail.hidden=true;
    button.disabled=true;
    let error='send';
    try{
      const res=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{accept:'application/json'}});
      const body=await res.json().catch(()=>({}));
      if(res.ok&&body.ok) error='';
      else error=body.error||'send';
    }catch{}
    button.disabled=false;
    if(error){
      fail.querySelector('span')!.textContent=errors[error]||'Versturen is niet gelukt.';
      fail.hidden=false;
      (window as any).turnstile?.reset();   // a Turnstile token works only once
      return;
    }
    const naam=(form.elements.namedItem('naam') as HTMLInputElement).value.trim().split(' ')[0];
    thanks.innerHTML='<h3></h3><p>Je bericht is verstuurd. Ik neem meestal binnen een dag contact met je op.</p>';
    thanks.querySelector('h3')!.textContent=`Bedankt, ${naam}!`;
    thanks.hidden=false;
    form.classList.add('sent');
  });
</script>
