---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import { projecten, type Project } from '../../data/projecten';

// one page per project that has a slug and photos, see src/data/projecten.ts
export function getStaticPaths() {
  const metPagina = projecten.filter((p) => p.slug && p.fotos);
  return metPagina.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      letter: String.fromCharCode(65 + projecten.indexOf(project)),
      vorige: metPagina[i - 1],
      volgende: metPagina[i + 1],
    },
  }));
}

interface Props {
  project: Project;
  letter: string;
  vorige?: Project;
  volgende?: Project;
}

const { project, letter, vorige, volgende } = Astro.props;
const specs = project.specs ?? [];
const ratio = (f: { src: ImageMetadata }) => f.src.width / f.src.height;
---
<BaseLayout
  title={`${project.titel} · Portfolio · Astrohout`}
  description={`${project.titel} van Astrohout: ${specs.join(', ')}.`}
  image={project.foto}
>
<main>
  <div class="narrow phead">
    <a class="eyebrow" href={`/portfolio#p-${letter.toLowerCase()}`}>Project {letter}</a>
    <h1>{project.titel}</h1>
    <p class="specs">{specs.join(' - ')}</p>
  </div>

  <section class="narrow gallery" aria-label="Foto's">
    {project.fotos!.map((rij, r) => {
      const totaal = rij.reduce((som, f) => som + ratio(f), 0);
      return (
        <div class="row">
          {rij.map((f) => (
            <Image
              src={f.src}
              alt={f.alt}
              style={`flex-grow:${ratio(f).toFixed(4)}`}
              widths={[600, 900, 1200, 1600, 2000]}
              sizes={`(max-width: 860px) calc(100vw - 76px), ${Math.round((1040 * ratio(f)) / totaal)}px`}
              loading={r === 0 ? 'eager' : 'lazy'}
            />
          ))}
        </div>
      );
    })}
  </section>

  <nav class="narrow pager" aria-label="Projecten">
    <a class="back" href="/portfolio">Terug naar portfolio</a>
    <div class="prevnext">
      {vorige && <a href={`/portfolio/${vorige.slug}`}><span>Vorige</span>{vorige.titel}</a>}
      {volgende && <a href={`/portfolio/${volgende.slug}`}><span>Volgende</span>{volgende.titel}</a>}
    </div>
  </nav>

  <div class="narrow">
    <section class="more">
      <h2>Ook iets op maat voor jouw ruimte?</h2>
      <p>Schuin dak, rare hoek of gewoon weinig plek: vertel wat je in gedachten hebt, dan denk ik mee.</p>
      <a class="btn" href="/contact">Neem contact op <Arrow /></a>
    </section>
  </div>
</main>
</BaseLayout>

<style is:global>
  /* ===== page head: label, title and the spec line ===== */
  .narrow.phead{padding-bottom:48px;}
  .eyebrow{display:inline-block;padding:7px 14px 0 9px;border-top:1px solid;border-left:1px solid;
    font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;line-height:1.4;color:var(--pencil);}
  .eyebrow:hover{color:var(--rust);}
  h1{font-size:clamp(44px,6vw,72px);line-height:1;margin-top:22px;}
  .specs{font-size:14px;line-height:2.1;max-width:52ch;margin-top:24px;color:var(--ink-soft);}

  /* ===== photos: each row fills the width, photos in a row share one height ===== */
  .gallery{display:flex;flex-direction:column;gap:18px;}
  .row{display:flex;gap:18px;}
  .row img{flex:1 1 0;min-width:0;height:auto;background:#f2f2f2;}   /* flex-grow = aspect ratio, set inline */

  /* ===== back to the overview, previous / next project ===== */
  .pager{display:flex;justify-content:space-between;align-items:baseline;gap:24px;flex-wrap:wrap;
    margin-top:48px;font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft);}
  .pager a:hover{color:var(--rust);}
  .back::before{content:"\2190\00a0\00a0";}
  .prevnext{display:flex;gap:32px;}
  .prevnext span{color:var(--pencil);margin-right:10px;}

  /* ===== closing call to action ===== */
  .more{padding:clamp(80px,10vw,120px) 0 clamp(96px,12vw,140px);}
  .more h2{font-size:clamp(26px,3vw,32px);line-height:1.6;}
  .more p{font-size:14px;line-height:2.1;max-width:40ch;margin-top:12px;}
  .more .btn{margin-top:36px;}

  @media (max-width:860px){
    .narrow.phead{padding-bottom:32px;}
    .gallery,.row{gap:12px;}
    .row{flex-direction:column;}   /* photos stacked on phones */
    .row img{flex:none !important;width:100%;}
    .pager{margin-top:36px;}
  }
</style>
